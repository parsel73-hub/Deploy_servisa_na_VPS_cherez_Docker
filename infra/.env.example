# Пример переменных окружения для docker-compose.yml
# Скопируй этот файл в .env (в папку infra/) и заполни значения.
# Файл .env НЕ должен попадать в git!

# Порт на хост-машине, на который пробрасывается контейнер (хост:контейнер)
HOST_PORT=8080

# Имя приложения (для логов/тегов)
APP_NAME=number-fact-api

# Уровень логирования uvicorn: critical | error | warning | info | debug
LOG_LEVEL=info
